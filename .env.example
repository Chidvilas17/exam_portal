# Exam Portal Environment Configuration Example

# Server port & Host
PORT=3000
NODE_ENV=development

# Database (Optional - application runs offline-first with full client/server sync)
DATABASE_URL=postgresql://user:password@localhost:5432/exam_portal

# Auth Secret (if connecting external NextAuth / JWT provider)
AUTH_SECRET=super_secret_exam_portal_key_32_chars_long

# Document Storage (Optional S3/Cloud Storage)
STORAGE_BUCKET=exam-portal-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional AI Explanation Service
DOCUMENT_PROCESSOR_API_KEY=
